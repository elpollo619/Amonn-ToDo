# ─── App web de Amonn ───────────────────────────────────────
# Copia este archivo como ".env" solo si necesitas cambiar los valores.

# URL del backend (servidor del NAS). Déjalo VACÍO si la app la sirve el
# propio servidor (mismo origen), que es lo normal con docker-compose.
# Para desarrollo local con el backend en otro puerto: http://localhost:4000
VITE_API_URL=

# Modo demostración: "true" usa datos de ejemplo locales, sin backend.
# Útil para ver la app sin levantar el servidor. En producción déjalo en false.
VITE_DEMO=false
