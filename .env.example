# ============================================================
# Configuración de Amonn — copia este archivo como ".env" y cambia los valores.
#   cp .env.example .env   (y edítalo)
# ============================================================

# Contraseña de la base de datos (invéntate una).
DB_PASSWORD=cambia-esta-contrasena

# Secreto para las sesiones de usuario. Pon una frase larga y aleatoria.
JWT_SECRET=cambia-esto-por-una-frase-muy-larga-y-aleatoria

# Puerto para abrir la app en el NAS → http://IP-DEL-NAS:8080
APP_PORT=8080

# ─── WhatsApp: tu OpenWA Gateway (open-wa.org) ───────────────
# Amonn se conecta a un OpenWA Gateway que ya tengas corriendo.
# URL del Gateway (IP del NAS + puerto, normalmente 2785):
WA_API_URL=http://IP-DEL-NAS:2785
# Clave del Gateway (cabecera X-API-Key), la ves en su panel o en data/.api-key:
WA_API_KEY=tu-api-key-del-gateway
# Id de la sesión de WhatsApp en el Gateway. "auto" = Amonn la detecta sola:
WA_SESSION_ID=auto
# Recibir mensajes en tiempo real por Socket.IO (recomendado). true por defecto;
# no necesita webhook ni abrir puertos. Ponlo a false solo si prefieres webhook.
WA_REALTIME=true
# --- Webhook (ALTERNATIVA opcional al tiempo real; normalmente vacío) ---
# URL a la que el Gateway enviaría los mensajes. Si se pone, Amonn registra el
# webhook al arrancar. Requiere que el Gateway permita destinos internos
# (WEBHOOK_SSRF_PROTECT=false en el Gateway):
WA_WEBHOOK_URL=
# Secreto del webhook (el mismo que use el webhook en el Gateway):
WA_WEBHOOK_SECRET=
# ¿Activar el agente de WhatsApp? true / false.
WA_ENABLED=true

# Cuándo enviar los recordatorios (formato cron). Por defecto L-V a las 9:00.
REMINDER_CRON=0 9 * * 1-5
# Horas mínimas entre dos recordatorios de la misma tarea.
REMINDER_COOLDOWN_HOURS=20
# Zona horaria (para el cron de recordatorios).
TZ=Europe/Madrid
