# ============================================================
# Configuración de Amonn — copia este archivo como ".env" y cambia los valores.
#   cp .env.example .env   (y edítalo)
# ============================================================

# Contraseña de la base de datos (invéntate una).
DB_PASSWORD=cambia-esta-contrasena

# Secreto para las sesiones de usuario. Pon una frase larga y aleatoria.
JWT_SECRET=cambia-esto-por-una-frase-muy-larga-y-aleatoria

# Clave de la API de WhatsApp (protege OpenWA). Cualquier texto secreto.
WA_API_KEY=cambia-esta-clave-de-whatsapp

# ¿Activar el agente de WhatsApp? true / false.
# Ponlo en "false" si quieres probar solo la app web antes de conectar el móvil.
WA_ENABLED=true

# Puerto para abrir la app en el NAS → http://IP-DEL-NAS:8080
APP_PORT=8080

# Cuándo enviar los recordatorios (formato cron). Por defecto L-V a las 9:00.
REMINDER_CRON=0 9 * * 1-5

# Horas mínimas entre dos recordatorios de la misma tarea.
REMINDER_COOLDOWN_HOURS=20

# Zona horaria (para el cron de recordatorios).
TZ=Europe/Madrid
